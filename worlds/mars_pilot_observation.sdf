<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10"><world name="mars_sandbox">
<gravity>0 0 -3.71</gravity>
<physics name="mars" type="ignored"><max_step_size>.004</max_step_size><real_time_factor>1</real_time_factor></physics>
<scene><ambient>.55 .41 .30 1</ambient><background>.25 .13 .09 1</background><shadows>true</shadows></scene>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 30 0 0 0</pose><diffuse>1 .82 .65 1</diffuse><direction>-.4 .2 -.9</direction></light>
<include><uri>model://mars_terrain</uri><name>mars_terrain</name></include>
<include><uri>model://astronaut</uri><name>human_1</name><pose>-9 -9 0.266 0 0 0</pose></include>
<include><uri>model://astronaut</uri><name>human_2</name><pose>-6 -12 0.135 0 0 0</pose></include>
<include><uri>model://scout_rover</uri><name>rover_1</name><pose>-15 -6 0.409 0 0 0</pose></include>
<include><uri>model://scout_rover</uri><name>rover_2</name><pose>-12 -15 0.24 0 0 0</pose></include>
<include><uri>model://scout_drone</uri><name>drone_1</name><pose>-6 -3 3.322 0 0 0</pose></include>
<include><uri>model://scout_drone</uri><name>drone_2</name><pose>-3 -6 4.097 0 0 0</pose></include>
<model name="habitat"><static>true</static><pose>-15 -21 1.5 0 0 0</pose><link name="module"><collision name="shell"><geometry><cylinder><radius>2.0</radius><length>2.6</length></cylinder></geometry></collision><visual name="shell_visual"><geometry><cylinder><radius>2.0</radius><length>2.6</length></cylinder></geometry><material><diffuse>.78 .78 .82 1</diffuse></material></visual></link></model>
<model name="science_a"><static>true</static><pose>15 9 -0.468 0 0 0</pose><link name="beacon"><visual name="marker"><geometry><cylinder><radius>.4</radius><length>.8</length></cylinder></geometry><material><diffuse>.15 .8 .65 1</diffuse></material></visual></link></model>
<model name="science_b"><static>true</static><pose>-18 21 -0.294 0 0 0</pose><link name="beacon"><visual name="marker"><geometry><cylinder><radius>.4</radius><length>.8</length></cylinder></geometry><material><diffuse>.95 .75 .23 1</diffuse></material></visual></link></model>
<model name="observer_overview"><static>true</static><pose>-48 -58 48 0 .61 .88</pose><link name="camera_link"><sensor name="overview" type="camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/pilot/overview</topic><camera><horizontal_fov>1.30</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>.1</near><far>180</far></clip></camera></sensor></link></model><model name="observer_agents"><static>true</static><pose>-22 -24 12 0 .49 .88</pose><link name="camera_link"><sensor name="agents" type="camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/pilot/agents</topic><camera><horizontal_fov>1.25</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>.1</near><far>180</far></clip></camera></sensor></link></model></world></sdf>